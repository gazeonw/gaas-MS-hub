# ===== AKEEYO 数字面试工具 环境变量 =====
# 复制本文件为 .env 后填写（.env 已在 .gitignore，不会被提交）

# 服务端口（本地默认 3000；Render 会注入 PORT，无需设置）
PORT=3000

# LLM 服务商：deepseek / gemini / openai
LLM_PROVIDER=deepseek

# DeepSeek（游戏模式：AI 买家 + 4 专家评委）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE=https://api.deepseek.com

# Gemini（备用）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE=https://generativelanguage.googleapis.com/v1beta

# OpenAI（备用）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 评分模式：manual=人工评分台（默认） / auto=提交后自动调 LLM
SCORE_MODE=manual

# HR 后台访问口令（自己设一个强口令）
ADMIN_TOKEN=change-me-strong-token

# 综合分权重（询盘 / 口语），合计需=1
INQUIRY_WEIGHT=0.6
ORAL_WEIGHT=0.4

# 评分失败重试次数
MAX_RETRY=5

# 无 Key 调试模式：设为 1 时返回模拟评分（不消耗 API）
MOCK_SCORE=0
